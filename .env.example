# ============================================================
# SALIM SAUKI DATA — ENVIRONMENT TEMPLATE
# ============================================================
# SAFE TEMPLATE ONLY.
# NEVER put real BOT_TOKEN, API keys, passwords or live secrets here.
# Real secrets belong ONLY in .env / cloud environment variables.
#
# Production architecture:
#   WEB    -> dashboard/API (Gunicorn)
#   WORKER -> Telegram polling + scanner + auto signal
#
# IMPORTANT:
# Only ONE Telegram polling worker may be active for this bot token
# at a time. Running local polling together with a cloud polling worker
# can cause Telegram 409 Conflict.
# ============================================================


# ============================================================
# TELEGRAM
# ============================================================

BOT_TOKEN=
BOT_USERNAME=
ADMIN_ID=

# Main Telegram group/chat for signals.
GROUP_ID=

# Optional dedicated signal chat.
# If empty, application falls back to GROUP_ID.
AUTO_SIGNAL_CHAT_ID=


# ============================================================
# API KEYS
# ============================================================

BIRDEYE_API_KEY=
RUGCHECK_API_KEY=
HELIUS_API_KEY=
FLUXRPC_API_KEY=

# Optional FluxRPC endpoint.
# Keep the real API key out of source code/logs.
FLUXRPC_RPC_URL=


# ============================================================
# AUTO SIGNAL ENGINE
# ============================================================

AUTO_SIGNAL_ENABLED=true
AUTO_SIGNAL_INTERVAL=60

# Final auto-delivery score gate.
AUTO_SIGNAL_MIN_SCORE=75

# Recommendation gate.
AUTO_SIGNAL_MIN_RECOMMENDATION=75

# Security must pass before auto delivery.
AUTO_SIGNAL_REQUIRE_SECURITY=true

# Solana auto-signal security threshold.
# EVM chains use their chain-specific security policy in the application.
AUTO_SIGNAL_MIN_SECURITY=90

AUTO_SIGNAL_REQUIRE_FINAL_SIGNAL=true

# Maximum signals across ALL supported chains per scan.
AUTO_SIGNAL_MAX_SIGNALS_PER_SCAN=8

# Maximum signals from one blockchain per scan.
AUTO_SIGNAL_MAX_SIGNALS_PER_CHAIN=2


# ============================================================
# PNL TRACKER
# ============================================================

PNL_TRACKER_ENABLED=true
PNL_TRACKER_INTERVAL=60
PNL_TRACKER_MAX_TRACKED=500
PNL_TRACKER_DRAWDOWN_ALERT=20


# ============================================================
# SCANNER — GLOBAL HARD FILTERS
# ============================================================

# IMPORTANT:
# Market-cap range must remain:
# $10,000 <= Market Cap <= $1,000,000

MIN_MARKETCAP=10000
MAX_MARKETCAP=1000000

MIN_LIQUIDITY=10000
MIN_VOLUME_24H=5000
MIN_TXNS=20
MIN_BUY_RATIO=0.50


# ============================================================
# GEM / SIGNAL SCORING
# ============================================================

MIN_GEM_SCORE=70
STRONG_GEM_SCORE=80
EARLY_GEM_SCORE=60
WATCH_SCORE=50

MIN_GEM_SIGNAL=65
MIN_STRONG_GEM=72
MIN_AI_SIGNAL=60

# Base/default security policy.
# Chain-specific final security rules are enforced by the application.
MIN_SECURITY_SCORE=69


# ============================================================
# FINAL SIGNAL ENGINE
# ============================================================

FINAL_MIN_LIQUIDITY=10000

FINAL_MIN_MARKET_CAP=10000
FINAL_MAX_MARKET_CAP=1000000

FINAL_MIN_BUY_RATIO=0.50
FINAL_MIN_VOLUME_RATIO=0.03
FINAL_MIN_TXNS=20

MAX_SAFE_VOLUME_RATIO=15
EXTREME_VOLUME_RATIO=25


# ============================================================
# SOLANA SECURITY
# ============================================================

REQUIRE_MINT_AUTHORITY_DISABLED=true
REQUIRE_FREEZE_AUTHORITY_DISABLED=true
REQUIRE_INITIALIZED=true


# ============================================================
# WALLET / SMART MONEY ANALYSIS
# ============================================================

WHALE_ANALYSIS_ENABLED=true
SMART_MONEY_ENABLED=true
WALLET_REPEAT_WINNER_TRACKING=true


# ============================================================
# GEM V9 CONFIRMATION
# ============================================================

GEM_V9_ENABLED=true
GEM_V9_CONFIRMATION_SCANS=3

# Keep confirmation requirement for automatic signals.
GEM_V9_REQUIRE_CONFIRMATION_FOR_AUTO=true


# ============================================================
# BASE / EVM RPC
# ============================================================

BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL_2=https://base-rpc.publicnode.com

# Honeypot checks are enabled for Base.
BASE_HONEYPOT_ENABLED=true
BASE_HONEYPOT_REQUIRED=true
BASE_HONEYPOT_TIMEOUT=15
BASE_HONEYPOT_CACHE_SECONDS=300


# ============================================================
# OTHER CHAINS
# ============================================================

SOLANA_RPC_URL=
SOLANA_RPC_URL_2=
SOLANA_RPC_URL_3=

ROBINHOOD_RPC_URL=
ARC_RPC_URL=


# ============================================================
# HELIUS
# ============================================================

# Helius is used as Solana RPC fallback after configured
# primary/fallback RPC endpoints fail.

HELIUS_API_KEY=


# ============================================================
# DEXSCREENER
# ============================================================

DEXSCREENER_API=https://api.dexscreener.com

DEXSCREENER_ENABLED=true

DEXSCREENER_CONNECT_TIMEOUT=20
DEXSCREENER_READ_TIMEOUT=40

# Minimum delay between DexScreener requests.
# Helps reduce HTTP 429 rate limiting.
DEXSCREENER_MIN_REQUEST_INTERVAL=0.35

DEXSCREENER_RETRIES=3


# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================

ENVIRONMENT=production

# ------------------------------------------------------------
# TELEGRAM POLLING
# ------------------------------------------------------------
# IMPORTANT:
# Only the Telegram WORKER should normally have polling enabled.
#
# Render:
#   WEB    -> false
#   WORKER -> true
#
# Local development:
#   true only when no cloud worker is polling the same bot token.
# ------------------------------------------------------------

TELEGRAM_POLLING_ENABLED=true

# Disabled by default to prevent a second Telegram polling process.
CLEANUP_POLLING_ENABLED=false


# ============================================================
# LOGGING
# ============================================================

DEBUG=false
LOG_LEVEL=INFO


# ============================================================
# TELEGRAM CLEANUP
# ============================================================

# Leave empty when cleanup uses the main bot.
CLEANUP_BOT_TOKEN=
CLEANUP_CHAT_ID=

CLEANUP_DELETE_AFTER_SECONDS=300
CLEANUP_CHECK_INTERVAL=15

CLEANUP_DATABASE_PATH=./cleanup_messages.db


# ============================================================
# DASHBOARD / WEB
# ============================================================

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Dashboard scan endpoint rate limit.
DASHBOARD_SCAN_RATE_LIMIT_SECONDS=15


# ============================================================
# DATABASE
# ============================================================

# Main database is kept local/private.
# Do NOT commit the live database to GitHub.
#
# Main DB:
#   ./salim_sauki_data.db
#
# Cleanup DB:
#   ./cleanup_messages.db


# ============================================================
# SECURITY NOTES
# ============================================================
#
# NEVER commit:
#   .env
#   salim_sauki_data.db
#   cleanup_messages.db
#   API keys
#   BOT_TOKEN
#
# NEVER print raw RPC URLs containing API keys in logs.
#
# Security thresholds:
#
#   Solana      -> 90/100
#   Base        -> 69/100
#   Robinhood   -> 69/100
#   Arc         -> 69/100
#
# Market-cap hard range:
#
#   Minimum -> $10,000
#   Maximum -> $1,000,000
#
# Auto Signal Telegram output:
#
#   STRONG GEM
#   GEM SIGNAL
#   EARLY GEM
#
# WATCH / NO SIGNAL should not be sent as automatic Telegram signals.
#
# No profit guarantees.
# Always use DYOR / risk / security / confidence messaging.
# ============================================================
