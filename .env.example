# =========================================================
# SALIM SAUKI DATA
# DEX ANALYSIS / AI GEM SCANNER
# ENVIRONMENT CONFIGURATION
# =========================================================

# =========================================================
# TELEGRAM BOT
# =========================================================

BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_ID=YOUR_TELEGRAM_ADMIN_ID
GROUP_ID=YOUR_TELEGRAM_GROUP_ID

# =========================================================
# TELEGRAM AUTO SIGNAL
# =========================================================

AUTO_SIGNAL_ENABLED=true
AUTO_SIGNAL_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
AUTO_SIGNAL_INTERVAL=60
AUTO_SIGNAL_MIN_SCORE=75
AUTO_SIGNAL_MIN_RECOMMENDATION=75
AUTO_SIGNAL_REQUIRE_SECURITY=true
AUTO_SIGNAL_MIN_SECURITY=90
AUTO_SIGNAL_REQUIRE_FINAL_SIGNAL=true

# =========================================================
# BOT INFORMATION
# =========================================================

BOT_NAME=SALIM SAUKI DATA
ADMIN_USERNAME=@YOUR_USERNAME
GROUP_USERNAME=@YOUR_GROUP
CHANNEL_USERNAME=@YOUR_CHANNEL

# =========================================================
# SOLANA RPC
# =========================================================

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_2=https://solana-rpc.publicnode.com
SOLANA_RPC_URL_3=https://api.mainnet-beta.solana.com

# =========================================================
# FLUXRPC
# =========================================================

FLUXRPC_API_KEY=YOUR_FLUXRPC_API_KEY

# =========================================================
# DEXSCREENER
# =========================================================

DEXSCREENER_API=https://api.dexscreener.com/latest/dex/search

# =========================================================
# BIRDEYE
# =========================================================

BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY

# =========================================================
# RUGCHECK
# =========================================================

RUGCHECK_API_KEY=YOUR_RUGCHECK_API_KEY

# =========================================================
# HELIUS
# =========================================================

# Optional. Current main scanning pipeline does not depend on Helius.
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# =========================================================
# SCANNER SETTINGS
# =========================================================

SCAN_INTERVAL=60
MAX_RESULTS=10

# =========================================================
# MARKET FILTERS
# =========================================================

MIN_MARKETCAP=10000
MAX_MARKETCAP=5000000
MIN_LIQUIDITY=10000
MIN_VOLUME_24H=5000
MIN_TXNS=20
MIN_BUY_RATIO=0.50

# =========================================================
# GEM DETECTION
# =========================================================

MIN_GEM_SCORE=70
STRONG_GEM_SCORE=80
EARLY_GEM_SCORE=60
WATCH_SCORE=50
MIN_GEM_SIGNAL=70
MIN_STRONG_GEM=75

# =========================================================
# AI SCORING
# =========================================================

MIN_AI_SIGNAL=65
AI_STRONG_BUY_SCORE=85
AI_BUY_SCORE=75
AI_WATCH_SCORE=65

# =========================================================
# SECURITY
# =========================================================

MIN_SECURITY_SCORE=80
AUTO_SIGNAL_MIN_SECURITY=90
REQUIRE_MINT_AUTHORITY_DISABLED=true
REQUIRE_FREEZE_AUTHORITY_DISABLED=true
REQUIRE_INITIALIZED=true

# =========================================================
# LIQUIDITY / VOLUME SAFETY
# =========================================================

FINAL_MIN_LIQUIDITY=20000
FINAL_MIN_MARKET_CAP=30000
FINAL_MAX_MARKET_CAP=5000000
FINAL_MIN_BUY_RATIO=0.55
FINAL_MIN_VOLUME_RATIO=0.05
FINAL_MIN_TXNS=50
MAX_SAFE_VOLUME_RATIO=15
EXTREME_VOLUME_RATIO=25

# =========================================================
# RECOMMENDATION ENGINE
# =========================================================

RECOMMENDATION_STRONG_BUY=85
RECOMMENDATION_BUY=75
RECOMMENDATION_WATCH=60
RECOMMENDATION_HIGH_RISK=45
RECOMMENDATION_MIN_SECURITY=90
RECOMMENDATION_MIN_LIQUIDITY=10000
RECOMMENDATION_MIN_VOLUME=5000
RECOMMENDATION_MIN_TXNS=20

# =========================================================
# WHALE / SMART MONEY
# =========================================================

WHALE_ANALYSIS_ENABLED=true
SMART_MONEY_ENABLED=true
WALLET_REPEAT_WINNER_TRACKING=true

# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=sqlite:///./salim_sauki_data.db

# =========================================================
# HTTP / API
# =========================================================

HTTP_TIMEOUT=30
HTTP_RETRIES=3

# =========================================================
# LOGGING
# =========================================================

LOG_LEVEL=INFO

# =========================================================
# ENVIRONMENT
# =========================================================

ENVIRONMENT=production
DEBUG=false
